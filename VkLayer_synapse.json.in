{
    "file_format_version": "1.0.0",
    "layer": {
        "name": "VK_LAYER_SYNAPSE_iGPU_Shim",
        "type": "GLOBAL",
        "library_path": "./@SYNAPSE_LAYER_FILENAME@",
        "api_version": "1.3.296",
        "implementation_version": "1",
        "description": "Project Synapse iGPU shim: ML-guided JIT/HAI/Oracle backend selection for Intel Arc and AMD RDNA3 integrated GPUs",
        "enable_environment": {
            "SYNAPSE_ENABLE": "1"
        },
        "disable_environment": {
            "SYNAPSE_DISABLE": "1"
        },
        "functions": {
            "vkGetInstanceProcAddr": "SynapseLayer_vkGetInstanceProcAddr",
            "vkGetDeviceProcAddr":   "SynapseLayer_vkGetDeviceProcAddr"
        },
        "instance_extensions": [],
        "device_extensions":  []
    }
}
